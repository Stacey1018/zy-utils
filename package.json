{
  "name": "zy-function-utils",
  "version": "1.0.1",
  "type": "module",
  "description": "## 初始化",
  "main": "dist/index.umd.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "scripts": {
    "build:esm": "webpack --config webpack.config.js --env format=esm",
    "build:umd": "webpack --config webpack.config.js --env format=umd",
    "build": "rm -rf dist && npm run build:esm && npm run build:umd",
    "test": "jest",
    "prepare": "husky",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "docs": "npx api-extractor run --local --verbose && api-documenter markdown -i temp -o docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@microsoft/api-documenter": "^7.26.27",
    "@microsoft/api-extractor": "^7.52.8",
    "@types/jest": "^29.5.14",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typedoc": "^0.28.4",
    "typedoc-plugin-markdown": "^4.6.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.24.0",
    "vitepress": "^1.6.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "clean-webpack-plugin": "^4.0.0",
    "path": "^0.12.7"
  },
  "lint-staged": {
    "**/*.test.ts": [
      "npm run test"
    ]
  }
}
